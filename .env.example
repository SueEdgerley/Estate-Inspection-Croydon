# Clerk (required for auth – email-only sign-in, no passwords)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: Clerk Dashboard → Webhooks → https://your-domain/api/webhooks/clerk → user.created, user.updated
# Signing secret (starts with whsec_) — provisions rows in Postgres `users` as soon as accounts exist in Clerk
# CLERK_WEBHOOK_SECRET=whsec_...
# Sign-in URL (must be public in middleware)
# CLERK_SIGN_IN_URL=/login
# CLERK_AFTER_SIGN_IN_URL=/

# Database (required for dashboard and inspections)
# App uses (first found): POSTGRES_URL, POSTGRES_PRISMA_URL, DATABASE_URL, DIRECT_URL, NEON_DATABASE_URL
# Prisma migrations use DATABASE_URL only – set it (e.g. same as POSTGRES_URL) for: npx prisma migrate deploy
# Get from Neon: https://neon.tech or Vercel Postgres
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_URL=postgresql://...   # Required for Prisma; can match POSTGRES_URL
# POSTGRES_PRISMA_URL=postgresql://...
# DIRECT_URL=postgresql://...

# Airtable (required for /api/templates and /api/inspections)
AIRTABLE_BASE_ID=your_base_id
# Primary: personal access token (Bearer) with access to this base — https://airtable.com/create/tokens
AIRTABLE_API_TOKEN=pat...
# Legacy fallback only (deprecated; if both are set, AIRTABLE_API_TOKEN wins)
# AIRTABLE_API_KEY=key...
# Optional – override table names if different in your base
# AIRTABLE_TEMPLATES_TABLE=Templates
# AIRTABLE_SECTIONS_TABLE=Template Sections
# AIRTABLE_QUESTIONS_TABLE=Template Questions
# AIRTABLE_GRADING_TABLE=Grading Schemes
# AIRTABLE_PEOPLE_TABLE=People
# AIRTABLE_INSPECTIONS_TABLE=Inspections
# AIRTABLE_INSPECTION_RESPONSES_TABLE=Inspection Responses
# Field name in that table for the answer value (Yes/No/NA etc.). Default: Response. Use Answer if your base uses that.
# AIRTABLE_RESPONSE_FIELD=Response
# Field for photo URLs in Inspection Responses. Default: Photo. Must be an attachment field.
# AIRTABLE_PHOTO_FIELD=Photo
# AIRTABLE_ACTIONS_TABLE=Actions

# Vercel Blob (required for PDF generation and photo uploads)
# Get from Vercel Dashboard → Storage → Blob → Settings
# Or run: vercel env pull (after linking project)
BLOB_READ_WRITE_TOKEN=vercel_blob_...
