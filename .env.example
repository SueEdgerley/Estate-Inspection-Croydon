# Database (required for dashboard and inspections)
# Get from Neon: https://neon.tech or Vercel Postgres
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# Airtable (required for /api/templates and /api/inspections)
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_API_KEY=your_api_key
# Optional – override table names if different in your base
# AIRTABLE_TEMPLATES_TABLE=Templates
# AIRTABLE_SECTIONS_TABLE=Template Sections
# AIRTABLE_QUESTIONS_TABLE=Template Questions
# AIRTABLE_GRADING_TABLE=Grading Schemes
# AIRTABLE_PEOPLE_TABLE=People
# AIRTABLE_INSPECTIONS_TABLE=Inspections
# AIRTABLE_INSPECTION_RESPONSES_TABLE=Inspection Responses
# AIRTABLE_ACTIONS_TABLE=Actions
