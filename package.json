{
  "name": "estate-inspection-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js",
    "build:debug": "prisma generate && next build 2>&1",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:prod": "node scripts/migrate-and-verify.js",
    "db:baseline": "node scripts/baseline-and-migrate.js",
    "db:verify": "node scripts/verify-tables.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "import:blocks": "node scripts/import-blocks-from-csv.mjs",
    "import:blocks:csv": "node scripts/import-blocks.js",
    "import:people": "node scripts/import-people.js",
    "verify:estate-v2": "node scripts/verify-estate-inspection-v2.mjs",
    "test:analytics-filters": "node --test scripts/analytics-filters.test.mjs",
    "test:analytics-load-guard": "node --test scripts/analytics-load-guard.test.mjs",
    "test:analytics-client-filters": "node --test scripts/analytics-client-filters.test.mjs",
    "test:analytics": "node --test scripts/analytics-filters.test.mjs scripts/analytics-load-guard.test.mjs scripts/analytics-client-filters.test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.0.0",
    "@neondatabase/serverless": "0.6.0",
    "@prisma/client": "^6.0.0",
    "@vercel/blob": "^0.24.0",
    "@vercel/postgres": "^0.5.1",
    "airtable": "^0.12.2",
    "csv-parse": "^5.5.0",
    "iconv-lite": "^0.6.3",
    "next": "^14.0.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0"
  }
}
